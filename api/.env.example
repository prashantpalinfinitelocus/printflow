# Copy to .env and adjust. All settings are optional — these are the defaults.

PRINTFLOW_DATABASE_URL=postgresql+psycopg://localhost/printflow

# CHANGE THIS IN ANY DEPLOYED ENVIRONMENT — it signs every session token.
PRINTFLOW_JWT_SECRET=dev-only-change-me
PRINTFLOW_JWT_EXPIRE_MINUTES=720

# Bootstrap admin, created by scripts/seed.py on first run.
PRINTFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@printflow.local
PRINTFLOW_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Fonts a print format can reference by filename. Designs that name a font here
# use it; anything else falls back to a system font that covers the text.
# Leave commented to use data/fonts — setting it blank points it at the CWD.
# PRINTFLOW_FONTS_DIR=/absolute/path/to/fonts

# Defaults for formats that do not override them. Die-cut labels need RGB with
# transparency (CMYK cannot carry an alpha channel) — set that per format.
# CMYK is what a print shop expects; RGB is easier to eyeball on screen.
PRINTFLOW_TIFF_COLORSPACE=CMYK
PRINTFLOW_TIFF_COMPRESSION=tiff_lzw
PRINTFLOW_RENDER_DPI=300

# Inset per side, in inches, when a format lays its label out on a page (its
# "Print on" setting). The page must land inside the printer's printable area:
# CUPS scales anything wider than that area down to fit, so a full-bleed A4
# artifact prints at 0.94x. Raise this for a printer with wider unprintable
# margins; the symptom is a print that is a few percent too small.
PRINTFLOW_PAGE_MARGIN_IN=0.25

# ICC profile used to separate to CMYK and embedded in the TIFF. Blank = auto
# detect a system profile. Set this to your printer's press profile for output
# that matches their proofs.
PRINTFLOW_CMYK_ICC_PROFILE=

# Set to false to render artifacts but never hand anything to CUPS.
PRINTFLOW_PRINTING_ENABLED=true
PRINTFLOW_LP_BINARY=lp
PRINTFLOW_LPSTAT_BINARY=lpstat

PRINTFLOW_CORS_ORIGINS=http://localhost:3000
