# Docker Compose settings. Copy to .env in this directory:
#   cp .env.example .env
#
# This file configures the containers. The API's own settings live in
# api/.env.example and are only used when running the API outside Docker.

# REQUIRED — compose refuses to start without it.
# Generate with:  openssl rand -hex 32
PRINTFLOW_JWT_SECRET=

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=printflow

# Host ports. Change any that collide with another stack on your machine
# (check with: docker ps --format '{{.Ports}}').
WEB_PORT=3000
API_PORT=8000
DB_PORT=15432

# Point at a Postgres you already run on the host instead of the container:
#   PRINTFLOW_DATABASE_URL=postgresql+psycopg://host.docker.internal/printflow
# PRINTFLOW_DATABASE_URL=

# Where the browser reaches the web app. Change if you map a different port.
PRINTFLOW_CORS_ORIGINS=http://localhost:3000

# Text moderation. Every CSV `text` is checked by Gemini before it can print;
# rows the model flags are imported but held until an admin approves them.
# Get a key at https://aistudio.google.com/apikey. Without one, every import
# is held as NEEDS_REVIEW (fail-closed) — set PRINTFLOW_MODERATION_ENABLED=false
# to switch the gate off instead.
GEMINI_API_KEY=
PRINTFLOW_MODERATION_ENABLED=true
# PRINTFLOW_MODERATION_MODEL=gemini-3.5-flash
# PRINTFLOW_MODERATION_EXTRA_COMPETITORS=Frooti, Jumpin
# Brand whose artwork this campaign prints on; the placement rule reads every
# message beside this logo. Default Diet Coke.
# PRINTFLOW_MODERATION_CAMPAIGN_BRAND=Diet Coke

# Printing from a container needs a reachable CUPS server — see SETUP.md.
# Leave false unless you have set CUPS_SERVER up.
PRINTFLOW_PRINTING_ENABLED=false
# CUPS_SERVER=host.docker.internal:631

# Consumer Diet Coke campaign (served at /user-campaign). While the Infobip flag is off,
# no OTP is sent: with the bypass on, only the bypass code logs in.
# Anyone who knows the code can log in as any number — never enable it live.
PRINTFLOW_CAMPAIGN_OTP_BYPASS=false
PRINTFLOW_CAMPAIGN_OTP_BYPASS_CODE=
# Set true to stop new entries without a deploy (the site shows "paused").
PRINTFLOW_CAMPAIGN_PAUSED=false
# Daily entry window: open at OPEN_HOUR, closed from CLOSE_HOUR (24 = midnight), in TIMEZONE.
# PRINTFLOW_CAMPAIGN_OPEN_HOUR=10
# PRINTFLOW_CAMPAIGN_CLOSE_HOUR=22
# PRINTFLOW_CAMPAIGN_TIMEZONE=Asia/Kolkata

# OTP limits (defaults shown). A phone may request SEND_LIMIT codes inside SEND_WINDOW_SECONDS;
# the next request blocks it for BLOCK_SECONDS. VERIFY_MAX_FAILURES wrong codes lock verifying.
# PRINTFLOW_CAMPAIGN_OTP_SEND_LIMIT=5
# PRINTFLOW_CAMPAIGN_OTP_SEND_WINDOW_SECONDS=300
# PRINTFLOW_CAMPAIGN_OTP_BLOCK_SECONDS=7200
# PRINTFLOW_CAMPAIGN_OTP_TTL_SECONDS=300
# PRINTFLOW_CAMPAIGN_OTP_VERIFY_MAX_FAILURES=5
# PRINTFLOW_CAMPAIGN_OTP_VERIFY_LOCK_SECONDS=7200
# PRINTFLOW_CAMPAIGN_OTP_VERIFY_WINDOW_SECONDS=1800
# Entries one phone may submit in total; 0 = no cap.
# PRINTFLOW_CAMPAIGN_MAX_ENTRIES_PER_PARTICIPANT=50

# Infobip SMS: OFF by default. Turn on only with a DLT-approved template; the DLT ids are
# deliberately blank (they belong to one brand's sender). {otp} marks where the code goes and
# the text must match the approved template exactly.
PRINTFLOW_CAMPAIGN_INFOBIP_ENABLED=false
# PRINTFLOW_CAMPAIGN_INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# PRINTFLOW_CAMPAIGN_INFOBIP_API_KEY=
# PRINTFLOW_CAMPAIGN_INFOBIP_SENDER_ID=
# PRINTFLOW_CAMPAIGN_INFOBIP_DLT_ENTITY_ID=
# PRINTFLOW_CAMPAIGN_INFOBIP_DLT_TEMPLATE_ID=
# PRINTFLOW_CAMPAIGN_INFOBIP_MESSAGE=
