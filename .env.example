# Docker Compose settings. Copy to .env in this directory:
#   cp .env.example .env
#
# This file configures the containers. The API's own settings live in
# api/.env.example and are only used when running the API outside Docker.

# REQUIRED — compose refuses to start without it.
# Generate with:  openssl rand -hex 32
PRINTFLOW_JWT_SECRET=

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=printflow

# Host ports. Change any that collide with another stack on your machine
# (check with: docker ps --format '{{.Ports}}').
WEB_PORT=3000
API_PORT=8000
DB_PORT=15432

# Point at a Postgres you already run on the host instead of the container:
#   PRINTFLOW_DATABASE_URL=postgresql+psycopg://host.docker.internal/printflow
# PRINTFLOW_DATABASE_URL=

# Where the browser reaches the web app. Change if you map a different port.
PRINTFLOW_CORS_ORIGINS=http://localhost:3000

# Text moderation. Every CSV `text` is checked by Gemini before it can print;
# rows the model flags are imported but held until an admin approves them.
# Get a key at https://aistudio.google.com/apikey. Without one, every import
# is held as NEEDS_REVIEW (fail-closed) — set PRINTFLOW_MODERATION_ENABLED=false
# to switch the gate off instead.
GEMINI_API_KEY=
PRINTFLOW_MODERATION_ENABLED=true
# PRINTFLOW_MODERATION_MODEL=gemini-3.5-flash
# PRINTFLOW_MODERATION_EXTRA_COMPETITORS=Frooti, Jumpin
# Brand whose artwork this campaign prints on; the placement rule reads every
# message beside this logo. Default Diet Coke.
# PRINTFLOW_MODERATION_CAMPAIGN_BRAND=Diet Coke

# Printing from a container needs a reachable CUPS server — see SETUP.md.
# Leave false unless you have set CUPS_SERVER up.
PRINTFLOW_PRINTING_ENABLED=false
# CUPS_SERVER=host.docker.internal:631
